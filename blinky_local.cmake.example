set(BLINKY_DEFINES
    "BLINKY_ENABLE_MQTT=1"
    "BLINKY_MQTT_BROKER=\"192.168.1.9\""
    # "BLINKY_IP=\"192.168.1.70\""
    # "BLINKY_GATEWAY=\"192.168.1.1\""
    CACHE STRING "" FORCE)
